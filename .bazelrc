# C99 standard
build --conlyopt=-std=c99
build --copt=-Wall
build --copt=-Wextra
build --copt=-fPIC
build --copt=-Wno-implicit-function-declaration

# Debug build
build:debug --copt=-g3
build:debug --copt=-O0
build:debug --strip=never

# Release build
build:release --copt=-O2
build:release --strip=always

# Mock mode - use mock URMA implementation
build:mock --copt=-DOS_TRANSPORT_MOCK_MODE=1
build:mock --define=mock_mode=true
