package(default_visibility = ["//visibility:public"])

config_setting(
    name = "mock_mode",
    define_values = {"mock_mode": "true"},
)

COMMON_SRCS = [
    "src/os_transport.c",
    "src/os_transport_thread_pool.c",
    "src/os_transport_urma.c",
    "src/os_transport_log.c",
]

MOCK_SRCS = [
    "mock/urma_mock_backend.c",
]

COMMON_COPTS = [
    "-std=c99",
    "-Wall",
    "-Wextra",
    "-O2",
    "-fPIC",
    "-Wno-implicit-function-declaration",
    "-D_POSIX_C_SOURCE=200809L",
]

cc_library(
    name = "os_transport_hdrs",
    hdrs = glob(["include/*.h"]),
    includes = ["include"],
)

cc_library(
    name = "os_transport_prefixed_hdrs",
    hdrs = glob(["include/*.h"]),
    strip_include_prefix = "include",
    include_prefix = "os-transport",
)

cc_library(
    name = "os_transport_unit_textual_src",
    textual_hdrs = ["src/os_transport.c"],
    deps = [":os_transport_hdrs"],
)

cc_library(
    name = "os_transport_log_unit_textual_src",
    textual_hdrs = ["src/os_transport_log.c"],
    deps = [":os_transport_hdrs"],
)

cc_library(
    name = "urma_mock",
    srcs = MOCK_SRCS,
    hdrs = glob(["mock/*.h"]),
    copts = COMMON_COPTS,
    includes = [
        "mock",
        "include",
        "src",
    ],
    deps = [":os_transport_hdrs"],
    linkopts = ["-lpthread"],
)

cc_library(
    name = "os_transport_lib",
    srcs = COMMON_SRCS + select({
        ":mock_mode": MOCK_SRCS,
        "//conditions:default": [],
    }),
    hdrs = glob(["include/*.h"]) + select({
        ":mock_mode": glob(["mock/*.h"]),
        "//conditions:default": [],
    }),
    copts = COMMON_COPTS,
    includes = [
        "include",
        "src",
    ] + select({
        ":mock_mode": ["mock"],
        "//conditions:default": [],
    }),
    deps = [
        ":os_transport_hdrs",
    ] + select({
        ":mock_mode": [":urma_mock"],
        "//conditions:default": ["@local_urma//:urma"],
    }),
    linkopts = [
        "-lpthread",
    ],
)

cc_binary(
    name = "libos_transport.so",
    srcs = COMMON_SRCS + select({
        ":mock_mode": MOCK_SRCS,
        "//conditions:default": [],
    }),
    copts = COMMON_COPTS + ["-Iinclude"],
    linkshared = True,
    deps = [
        ":os_transport_hdrs",
    ] + select({
        ":mock_mode": [":urma_mock"],
        "//conditions:default": ["@local_urma//:urma"],
    }),
    linkopts = [
        "-lpthread",
        "-Wl,-z,defs",
    ],
)

cc_test(
    name = "test_thread_pool",
    srcs = [
        "test/test_thread_pool.c",
        "src/os_transport_thread_pool.c",
        "src/os_transport_log.c",
    ] + select({
        ":mock_mode": glob(["mock/*.h"]),
        "//conditions:default": [],
    }),
    copts = COMMON_COPTS,
    includes = ["include"] + select({
        ":mock_mode": ["mock"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpthread"],
    deps = [":os_transport_hdrs"],
)

cc_test(
    name = "test_os_transport_log_unit",
    srcs = [
        "test/test_os_transport_log_unit.c",
    ] + select({
        ":mock_mode": glob(["mock/*.h"]),
        "//conditions:default": [],
    }),
    copts = COMMON_COPTS,
    includes = [
        "include",
        "src",
    ] + select({
        ":mock_mode": ["mock"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpthread"],
    deps = [
        ":os_transport_hdrs",
        ":os_transport_log_unit_textual_src",
    ],
)

cc_test(
    name = "test_os_transport_unit",
    srcs = [
        "test/test_os_transport_unit.c",
    ] + select({
        ":mock_mode": glob(["mock/*.h"]),
        "//conditions:default": [],
    }),
    copts = COMMON_COPTS,
    includes = [
        "include",
        "src",
    ] + select({
        ":mock_mode": ["mock"],
        "//conditions:default": [],
    }),
    linkopts = ["-lpthread"],
    deps = [
        ":os_transport_hdrs",
        ":os_transport_unit_textual_src",
    ],
)